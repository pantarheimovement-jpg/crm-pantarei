{
  "name": "AutomationSettings",
  "type": "object",
  "properties": {
    "whatsapp_bot_enabled": {
      "type": "boolean",
      "default": false,
      "description": "הפעלת בוט WhatsApp"
    },
    "auto_response_time": {
      "type": "number",
      "default": 1,
      "description": "זמן תגובה אוטומטית (דקות)"
    },
    "welcome_message": {
      "type": "string",
      "default": "שלום! תודה על ההתעניינות באולפן פנטרהיי 💜",
      "description": "הודעת ברוכים הבאים"
    },
    "whatsapp_auto_reply": {
      "type": "string",
      "default": "הי {{name}}, קיבלנו את פנייתך 💜 אנחנו נדאג ליצור איתך קשר בהקדם. סטודיו פנטהריי",
      "description": "הודעת תגובה אוטומטית להודעת וואטסאפ נכנסת מליד חדש"
    },
    "whatsapp_auto_reply_enabled": {
      "type": "boolean",
      "default": true,
      "description": "הפעלת תגובה אוטומטית לוואטסאפ נכנס"
    },
    "whatsapp_new_lead_from_site": {
      "type": "string",
      "default": "הי {{name}}, קיבלנו את פנייתך בנוגע ל{{course}} 💜 ניצור איתך קשר בהקדם. סטודיו פנטהריי",
      "description": "הודעת וואטסאפ לליד חדש שמגיע מטופס באתר (עם שם קורס)"
    },
    "whatsapp_task_try_call_message": {
      "type": "string",
      "default": "הי {{name}}, ניסיתי ליצור איתך קשר, מתי יהיה לך נוח לדבר?",
      "description": "הודעת וואטסאפ אוטומטית כשסטטוס שיחה משתנה לניסיון לשיחה"
    },
    "whatsapp_lbms_status_messages": {
      "type": "string",
      "description": "הודעות וואטסאפ אוטומטיות לפי סטטוס לקורסי LBMS"
    },
    "whatsapp_nana_status_messages": {
      "type": "string",
      "description": "הודעות וואטסאפ אוטומטיות לפי סטטוס לקורסי נענע"
    },
    "newsletter_sending_enabled": {
      "type": "boolean",
      "default": false,
      "description": "הפעלת שליחת ניוזלטרים ומיילים (Brevo וגיבוי Gmail)"
    },
    "webhook_url": {
      "type": "string",
      "description": "URL webhook (Summit)"
    },
    "auto_tagging_enabled": {
      "type": "boolean",
      "default": false,
      "description": "סיווג אוטומטי"
    },
    "payment_link_template": {
      "type": "string",
      "description": "תבנית קישור תשלום"
    },
    "registration_followups_enabled": {
      "type": "boolean",
      "default": true,
      "description": "הפעלת הודעות תזכורת הרשמה אוטומטיות (followup_1 מיידית + followup_3days מעקב 3 ימים). לא משפיע על תזכורת week_before (7 ימים לפני קורס)"
    }
  },
  "required": []
}
