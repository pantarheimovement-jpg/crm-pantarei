{
  "name": "Course",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "שם הקורס"
    },
    "type": {
      "type": "string",
      "enum": [
        "קורס קבוע",
        "סדנה",
        "פרטי",
        "אונליין"
      ],
      "default": "קורס קבוע",
      "description": "סוג הקורס"
    },
    "description": {
      "type": "string",
      "description": "תיאור"
    },
    "schedule": {
      "type": "string",
      "description": "לוז (למשל: ימי שני ורביעי 18:00)"
    },
    "location": {
      "type": "string",
      "description": "מיקום"
    },
    "dates_text": {
      "type": "string",
      "description": "מועדי הקורס כטקסט חופשי, למשל: 5-16.7 (משמש בתבנית וואטסאפ followup_1)"
    },
    "payment_link": {
      "type": "string",
      "description": "קישור לדף התשלום בסאמיט (משמש בתבנית וואטסאפ followup_1)"
    },
    "registration_link": {
      "type": "string",
      "description": "קישור לדף הקורס באתר (משמש בתבנית וואטסאפ followup_1)"
    },
    "price_early": {
      "type": "number",
      "description": "מחיר הרשמה מוקדמת"
    },
    "price_late": {
      "type": "number",
      "description": "מחיר הרשמה מאוחרת"
    },
    "price_early_week1": {
      "type": "number",
      "description": "הרשמה מוקדמת – שבוע ראשון (סמסטר קיץ נענע)"
    },
    "price_early_week2": {
      "type": "number",
      "description": "הרשמה מוקדמת – שבוע שני (סמסטר קיץ נענע)"
    },
    "price_early_two_weeks": {
      "type": "number",
      "description": "הרשמה מוקדמת – שבועיים מלאים (סמסטר קיץ נענע)"
    },
    "price_early_3days_week1": {
      "type": "number",
      "description": "הרשמה מוקדמת – 3 ימים מהשבוע הראשון (סמסטר קיץ נענע)"
    },
    "price_early_3days_week2": {
      "type": "number",
      "description": "הרשמה מוקדמת – 3 ימים מהשבוע השני (סמסטר קיץ נענע)"
    },
    "price_late_week1": {
      "type": "number",
      "description": "הרשמה מאוחרת – שבוע ראשון (סמסטר קיץ נענע)"
    },
    "price_late_week2": {
      "type": "number",
      "description": "הרשמה מאוחרת – שבוע שני (סמסטר קיץ נענע)"
    },
    "price_late_two_weeks": {
      "type": "number",
      "description": "הרשמה מאוחרת – שבועיים מלאים (סמסטר קיץ נענע)"
    },
    "price_late_3days_week1": {
      "type": "number",
      "description": "הרשמה מאוחרת – 3 ימים מהשבוע הראשון (סמסטר קיץ נענע)"
    },
    "price_late_3days_week2": {
      "type": "number",
      "description": "הרשמה מאוחרת – 3 ימים מהשבוע השני (סמסטר קיץ נענע)"
    },
    "max_students": {
      "type": "number",
      "description": "מספר משתתפים מקסימלי"
    },
    "current_students": {
      "type": "number",
      "default": 0,
      "description": "מספר משתתפים נוכחי"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "תאריך התחלה"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "תאריך סיום"
    },
    "status": {
      "type": "string",
      "enum": [
        "לא פתוח להרשמה",
        "פתוח להרשמה",
        "מלא",
        "בתהליך",
        "הסתיים"
      ],
      "default": "לא פתוח להרשמה",
      "description": "סטטוס"
    },
    "image_url": {
      "type": "string",
      "description": "תמונה"
    },
    "teacher_email": {
      "type": "string",
      "format": "email",
      "description": "אימייל המורה (לגישה לדף קורס ייעודי)"
    },
    "teacher_token": {
      "type": "string",
      "description": "טוקן סודי לדף המורה הציבורי — מי שמחזיק בקישור עם הטוקן יכול לצפות ולמלא נוכחות ללא התחברות"
    },
    "kind": {
      "type": "string",
      "enum": [
        "קורס",
        "יום היכרות",
        "אירוע",
        "תרומה",
        "השכרה",
        "בדיקה"
      ],
      "default": "קורס",
      "description": "מה המיכל הזה באמת. רק 'קורס' הופך משתתפת ללקוחה — 'יום היכרות' הוא שלב במשפך"
    },
    "summit_catalog": {
      "type": "string",
      "description": "שם הקטלוג המקביל בסאמיט, להתמצאות בלבד"
    },
    "options": {
      "type": "array",
      "description": "המסלולים שאפשר לרכוש בקורס הזה. ניתן לפתוח אפשרות עם מחיר לפני שמישהי שילמה — ומכאן צפי הכנסות מול בפועל",
      "items": {
        "type": "object",
        "properties": {
          "option_id": {
            "type": "string",
            "description": "מזהה יציב — כדי ששינוי שם לא ישבור שיוכים קיימים"
          },
          "name": {
            "type": "string",
            "description": "שם האפשרות, למשל: יסודות ב' · מפגש בודד · כרטיס אוהבתכם"
          },
          "price": {
            "type": "number",
            "description": "המחיר — גם לפני שמישהי שילמה. זה מה שמאפשר לחשב צפי הכנסות"
          },
          "summit_product_name": {
            "type": "string",
            "description": "השם המדויק בסאמיט — עוגן השיוך האוטומטי"
          },
          "payment_link": {
            "type": "string",
            "description": "קישור התשלום הישיר למסלול הזה"
          },
          "dates_text": {
            "type": "string",
            "description": "מועדים כטקסט חופשי — לימי היכרות וסדנאות שלכל תאריך יש מועד משלו"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "תאריך המסלול — לתזכורות ולנוכחות"
          },
          "capacity": {
            "type": "number",
            "description": "מקומות במסלול הזה"
          },
          "status": {
            "type": "string",
            "enum": [
              "פתוח להרשמה",
              "מלא",
              "לא פתוח להרשמה",
              "הסתיים"
            ],
            "default": "פתוח להרשמה",
            "description": "מסלול אחד יכול להיות מלא בזמן שאחר פתוח"
          },
          "is_manual": {
            "type": "boolean",
            "default": true,
            "description": "הוזן ידנית — כדי שקליטה מסאמיט לא תדרוס בשקט"
          }
        },
        "required": [
          "option_id",
          "name"
        ]
      }
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}