{
  "name": "Student",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "שם מלא"
    },
    "phone": {
      "type": "string",
      "description": "טלפון"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "מייל"
    },
    "status": {
      "type": "string",
      "default": "ליד חדש",
      "description": "סטטוס בפייפליין"
    },
    "lead_source": {
      "type": "string",
      "enum": [
        "אתר",
        "וואטסאפ",
        "פייסבוק",
        "ידני",
        "אחר"
      ],
      "default": "אחר",
      "description": "מקור ליד"
    },
    "interest_area": {
      "type": "string",
      "description": "תחום עניין"
    },
    "lead_entry_date": {
      "type": "string",
      "format": "date",
      "description": "תאריך כניסת הליד"
    },
    "registration_date": {
      "type": "string",
      "format": "date",
      "description": "תאריך רישום לקורס"
    },
    "course_id": {
      "type": "string",
      "description": "מזהה קורס (קורס עיקרי לתאימות לאחור)"
    },
    "course_name": {
      "type": "string",
      "description": "שם קורס (קורס עיקרי לתצוגה, לתאימות לאחור)"
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "course_id": {
            "type": "string",
            "description": "מזהה קורס"
          },
          "course_name": {
            "type": "string",
            "description": "שם קורס"
          },
          "status": {
            "type": "string",
            "description": "סטטוס בקורס הזה (ליד חדש, רשום וכו')"
          },
          "option": {
            "type": "string",
            "description": "שם האפשרות כטקסט (תאימות לאחור — המקור האמיתי הוא option_id)"
          },
          "registration_date": {
            "type": "string",
            "format": "date",
            "description": "תאריך רישום לקורס"
          },
          "total_price": {
            "type": "number",
            "description": "הסכום הכולל עבור הקורס"
          },
          "installment_amount": {
            "type": "number",
            "description": "סכום התשלום החודשי"
          },
          "payment_number": {
            "type": "number",
            "description": "מספר תשלום נוכחי (חדש)"
          },
          "payments_total": {
            "type": "number",
            "description": "מספר התשלומים הכולל"
          },
          "option_id": {
            "type": "string",
            "description": "מזהה האפשרות ב-Course.options[] — קישור יציב שלא נשבר משינוי שם"
          },
          "paid_so_far": {
            "type": "number",
            "description": "כמה שולם בפועל עבור הקורס הזה (₪) — מצטבר מכל החיובים המשויכים אליו"
          },
          "paid_source": {
            "type": "string",
            "enum": [
              "סאמיט",
              "יומן הערות",
              "ידני"
            ],
            "description": "מקור הסכום ב-paid_so_far — כדי שערך שהוזן ידנית לא יידרס בשקט"
          }
        },
        "required": [
          "course_id",
          "course_name",
          "status"
        ]
      },
      "description": "רשימת כל הקורסים והסטטוסים של המשתתף"
    },
    "notes": {
      "type": "string",
      "description": "הערות"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "תגיות"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date-time",
      "description": "תאריך יצירת קשר אחרון"
    },
    "payment_number": {
      "type": "number",
      "description": "מספר תשלום נוכחי (1, 2, 3...) — ברמת הסטודנט לתאימות לאחור"
    },
    "total_payments": {
      "type": "number",
      "description": "סה\"כ תשלומים"
    },
    "amount_paid": {
      "type": "number",
      "description": "סכום ששולם עד כה בפועל (₪) — מצטבר מכל החיובים דרך Summit"
    },
    "marketing_consent": {
      "type": "boolean",
      "default": false,
      "description": "אושר מדיניות הפרטיות והסכמה לקבל עדכונים במייל ובוואטסאפ"
    },
    "nana_option": {
      "type": "string",
      "enum": [
        "5-16.7",
        "5-9.7",
        "12-16.7",
        "5-7.7",
        "12-14.7",
        "יום בודד"
      ],
      "description": "אפשרות רישום לסמסטר קיץ נענע (מיושן — מוחלף ב-Course.options[])"
    },
    "is_customer": {
      "type": "boolean",
      "default": false,
      "description": "האם הפך ללקוח (נרשם לפחות לקורס אחד)"
    },
    "uchat_user_ns": {
      "type": "string",
      "description": "מזהה מנוי ב-uChat (user_ns) לשליחת וואטסאפ ללא lookup"
    }
  },
  "required": [
    "full_name",
    "phone"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}